// Status: prepared; validate field population and thresholds with marked lab activity.
// Purpose: correlate resource creation or update with a later deletion by the same caller.
let Lookback = 24h;
let Changes = AzureActivity
| where TimeGenerated >= ago(Lookback)
| where ActivityStatusValue =~ "Success"
| where OperationNameValue has_any ("/write", "/delete")
| extend Action = iff(OperationNameValue endswith "/delete", "Delete", "Write")
| project TimeGenerated, Caller, ResourceId, ResourceGroup, CorrelationId, Action;
Changes
| summarize FirstWrite=minif(TimeGenerated, Action == "Write"),
    FirstDelete=minif(TimeGenerated, Action == "Delete"),
    Correlations=make_set(CorrelationId, 10)
    by Caller, ResourceId, ResourceGroup
| where isnotnull(FirstWrite) and isnotnull(FirstDelete) and FirstDelete > FirstWrite
| extend TimeGenerated=FirstDelete, Elapsed=FirstDelete - FirstWrite
| project TimeGenerated, Caller, ResourceId, ResourceGroup, FirstWrite,
    FirstDelete, Elapsed, Correlations
